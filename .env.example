# CarePath configuration template.
# Copy to `.env` locally and fill values there. NEVER commit `.env`.
# Secret fields are intentionally blank. Empty values fall back to the documented default
# (or "not configured" for optional integrations). See docs/ARCHITECTURE.md#configuration.

APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO

# NVIDIA hosted OpenAI-compatible API (use a freshly rotated key)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
JUDGE_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MAX_CONCURRENCY=4

# Embeddings (provider adapter arrives in Phase 5; not required to boot)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
GEMINI_API_KEY=

# PostgreSQL (canonical store). Docker Compose default shown.
DATABASE_URL=postgresql+asyncpg://carepath:carepath@localhost:5432/carepath

# Qdrant (optional; Phase 5)
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=carepath_evidence

# Neo4j (optional; Phase 6)
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Search adapter (optional; Phase 4)
SEARXNG_BASE_URL=

# Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=carepath-research
LOGFIRE_TOKEN=

# UI -> backend
BACKEND_URL=http://localhost:8000
# Required when APP_ENV is staging/production. Optional for local development.
API_BEARER_TOKEN=
# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:8501

# Voice (disabled until configured; Phase 8)
VOICE_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

# Job runner and safety controls
RESEARCH_MAX_WORKERS=3
RESEARCH_MAX_STEPS=12
RESEARCH_MAX_SOURCES=30
JOB_TIMEOUT_SECONDS=300
